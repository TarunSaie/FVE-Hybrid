{
  "expo": {
    "name": "FitVerse Elite",
    "slug": "fve-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#050505",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#050505",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitverse.elite",
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#050505",
      "infoPlist": {
        "NSCameraUsageDescription": "FitVerse Elite uses the camera to scan member QR codes for gym attendance check-in."
      }
    },
    "android": {
      "package": "com.fitverse.elite",
      "backgroundColor": "#050505",
      "userInterfaceStyle": "automatic",
      "softwareKeyboardLayoutMode": "resize",
      "androidStatusBar": {
        "backgroundColor": "#050505",
        "barStyle": "light-content",
        "translucent": true
      },
      "androidNavigationBar": {
        "backgroundColor": "#050505",
        "barStyle": "light-content"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#050505",
        "resizeMode": "contain"
      },
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "FitVerse Elite needs access to your camera to scan member QR check-ins."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050505",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-sharing",
      "expo-audio"
    ]
  }
}
